{
  "name": "@review-agent/sdk",
  "version": "0.2.2",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crissmoldovan/review-agent.git",
    "directory": "packages/sdk"
  },
  "files": ["dist"],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@octokit/core": "^7.0.8",
    "@review-agent/core": "workspace:*",
    "@review-agent/github": "workspace:*"
  },
  "devDependencies": {
    "tar": "^7.4.3"
  }
}
